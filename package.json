{
  "name": "tab-links",
  "displayName": "TabLinks",
  "description": "Shows links between your open tabs, such as interface to implementation, and jumps to the exact place.",
  "version": "0.0.1",
  "publisher": "fluorinestudios",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": [ "Visualization", "Other" ],
  "keywords": [ "navigation", "tabs", "implementation", "interface", "references" ],
  "activationEvents": [ "onStartupFinished" ],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "tablinks.jumpFromCursor", "title": "TabLinks: Jump to a linked tab" },
      { "command": "tablinks.refresh", "title": "TabLinks: Refresh links" },
      { "command": "tablinks.toggle", "title": "TabLinks: Toggle links" }
    ],
    "keybindings": [
      { "command": "tablinks.jumpFromCursor", "key": "ctrl+alt+j", "when": "editorTextFocus" }
    ],
    "configuration": {
      "title": "TabLinks",
      "properties": {
        "tablinks.enabled": { "type": "boolean", "default": true, "description": "Show links between open tabs." },
        "tablinks.showUsages": { "type": "boolean", "default": true, "description": "Also link a symbol to the symbols in other open tabs that use it. If off, only interface and implementation links show." },
        "tablinks.maxOpenDocs": { "type": "integer", "default": 10, "minimum": 2, "description": "Largest number of open tabs to analyze." },
        "tablinks.maxSymbolsPerDoc": { "type": "integer", "default": 200, "minimum": 10, "description": "Largest number of symbols to analyze in one tab." },
        "tablinks.maxLensPerSymbol": { "type": "integer", "default": 3, "minimum": 1, "maximum": 10, "description": "Links shown above one symbol. The rest open in a list." }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
